# Development values only. Copy to .env; never use these credentials in production.
# Host-side clients (API, worker, migration commands). Docker publishes only on loopback.
DOCUMIND_ENVIRONMENT=development
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:documind-local-only@127.0.0.1:55432/documind
DOCUMIND_REDIS_URL=redis://127.0.0.1:56379/0
DOCUMIND_RESULT_BACKEND=redis://127.0.0.1:56379/1
DOCUMIND_S3_ENDPOINT=http://127.0.0.1:59000
DOCUMIND_S3_ACCESS_KEY=documind-local
DOCUMIND_S3_SECRET_KEY=documind-local-secret-only
DOCUMIND_S3_BUCKET=documind-documents
DOCUMIND_S3_REGION=us-east-1
# Compose interpolation. If ports or passwords change, update client URLs above as well.
DOCUMIND_DB_PORT=55432
DOCUMIND_DB_PASSWORD=documind-local-only
DOCUMIND_REDIS_PORT=56379
DOCUMIND_S3_PORT=59000
DOCUMIND_S3_CONSOLE_PORT=59001
# Generate a private random value with `uv run python -m scripts.init_env`.
# Authentication returns 503 until a signing key of at least 32 bytes is configured.
DOCUMIND_AUTH_SECRET=
DOCUMIND_ACCESS_TTL_SECONDS=300
DOCUMIND_REFRESH_TTL_SECONDS=604800
DOCUMIND_COOKIE_SECURE=false
# Binary limit plus a separate bounded multipart envelope; bytes, not megabytes.
DOCUMIND_UPLOAD_MAX_BYTES=20971520
DOCUMIND_DOCX_MAX_EXPANDED_BYTES=52428800
DOCUMIND_PROCESSING_PIPELINE_KEY=text-v1
